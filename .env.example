# Copy to .env and fill in real values before running `docker compose up`.
# Generate secrets with: openssl rand -hex 32

# ---- Required ----
# Strong random secret used to sign JWTs.
JWT_SECRET=

# Postgres credentials. POSTGRES_PASSWORD is required (compose refuses to start
# without it). If the password contains URL-reserved characters (@ : / ? # %),
# URL-encode it for DATABASE_URL.
POSTGRES_DB=ems_db
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=

# ---- Optional ----
# Origin the browser uses to reach the app. Server uses it for CORS and for
# building reset/invite email links.
CLIENT_URL=http://localhost:3000

# Base URL baked into the client build. Keep at "/api" so nginx proxies requests
# same-origin. Only change if the API lives on a separate domain.
VITE_API_URL=/api

# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false

# Cloudinary (file uploads). If unset, upload endpoints will error — the app
# otherwise runs without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (email delivery). If unset, emails are logged to the server console
# instead of delivered. Set it in production or invite/reset links never send.
RESEND_API_KEY=
EMAIL_FROM="EMS Pro <onboarding@resend.dev>"

# Database used by the server container (defaults to the Postgres service above).
#DATABASE_URL=postgresql://ems_user:PASSWORD@postgres:5432/ems_db